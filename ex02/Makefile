# **************************************************************************** #
#                                 COMPILER                                     #
# **************************************************************************** #
CC       = c++
CFLAGS   = -Wall -Wextra -Werror -std=c++98
NAME     = PmergeMe

# **************************************************************************** #
#                               FILE STRUCTURE                                 #
# **************************************************************************** #
OBJ_DIR  = obj/
SRCS     = main.cpp PmergeMe.cpp debug/PmergeMe2.cpp
OBJS     = $(addprefix $(OBJ_DIR), $(SRCS:.cpp=.o))

# **************************************************************************** #
#                                   RULES                                      #
# **************************************************************************** #
.SILENT:

all: $(NAME)

$(OBJ_DIR)%.o: %.cpp
	mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

$(NAME): $(OBJS)
	$(CC) $(CFLAGS) $(OBJS) -o $(NAME)

# **************************************************************************** #
#                                 CLEANING                                     #
# **************************************************************************** #
clean:
	rm -rf $(OBJ_DIR)

fclean: clean
	rm -f $(NAME)

re: fclean all

.PHONY: all clean fclean re
